# Insumo de build do Vite. O `.env` real e versionado (ver comentario no .gitignore):
# so entram aqui valores PUBLICOS, que ja viajam no bundle do browser.
#
# NUNCA adicione neste arquivo, nem no `.env`:
#   - token da Management API (`sbp_...`)     -> variavel de ambiente, ver RULES.md §10
#   - service role key / `sb_secret_...`      -> segredo de Edge Function
#   - senha de banco, de e-mail ou de usuario
# O teste `security-contract` falha se qualquer um desses padroes aparecer.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Duplicados sem o prefixo VITE_, lidos por scripts fora do bundle:
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
